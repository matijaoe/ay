{
  "name": "ay",
  "version": "0.0.1",
  "description": "Git worktree manager — create, switch, and manage worktrees with ease",
  "type": "module",
  "bin": {
    "ay": "./dist/index.mjs"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.ts"
    },
    "./schema.json": "./schema.json"
  },
  "files": [
    "dist",
    "schema.json"
  ],
  "scripts": {
    "build": "unbuild",
    "dev": "bun run src/index.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "generate-schema": "bun run scripts/generate-schema.ts",
    "prepublishOnly": "bun run build && bun run generate-schema"
  },
  "keywords": [
    "git",
    "worktree",
    "cli",
    "developer-tools"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "c12": "^4.0.0-beta.2",
    "citty": "^0.2.1",
    "consola": "^3.4.2",
    "defu": "^6.1.4",
    "execa": "^9.6.1",
    "simple-git": "^3.30.0",
    "tinyglobby": "^0.2.15",
    "unique-names-generator": "^4.7.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.15",
    "@types/node": "^25.2.3",
    "typescript": "^5.9.3",
    "unbuild": "^3.6.1",
    "vitest": "^4.0.18"
  }
}
